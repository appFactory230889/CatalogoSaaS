{
  "rules": {
    ".read": false,
    ".write": false,
    "contadores": {
      "ultimoCodigoCliente": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
      }
    },
    "codigosCliente": {
      "$n": {
        ".read": "true",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "planes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['plan', 'limite', 'vigenteHasta'])",
        "plan": {
          ".validate": "newData.isString() && newData.val().matches(/^(gratis|premium)$/)"
        },
        "limite": {
          ".validate": "newData.isNumber() && newData.val() >= 250 && newData.val() <= 100000"
        },
        "vigenteHasta": {
          ".validate": "newData.isNumber()"
        },
        "metodo": {
          ".validate": "newData.isString() && newData.val().matches(/^(transferencia|paddle|manual)$/)"
        },
        "actualizadoEn": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "negocios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.uid === $uid && newData.exists()) && !root.child('bloqueos').child($uid).exists()",
        ".validate": "newData.hasChildren(['nombre', 'codigoCliente', 'codigoDisponible', 'totalItems'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60",
          ".read": "(!root.child('bloqueos').child($uid).exists() || (auth != null && auth.uid === $uid) || (auth != null && root.child('admins').child(auth.uid).val() === true))"
        },
        "contacto": {
          ".validate": "newData.isString()"
        },
        "creadoEn": {
          ".validate": "newData.isNumber()"
        },
        "codigoCliente": {
          ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.parent().parent().parent().child('codigosCliente').child(newData.val() + '').val() === $uid))",
          ".read": "(!root.child('bloqueos').child($uid).exists() || (auth != null && auth.uid === $uid) || (auth != null && root.child('admins').child(auth.uid).val() === true))"
        },
        "codigoDisponible": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() || (newData.val() === data.val() + 1 && newData.parent().parent().parent().child('productos').child($uid).child(data.val() + '').exists() && !root.child('productos').child($uid).child(data.val() + '').exists()))"
        },
        "totalItems": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 0) || newData.val() === data.val() || (newData.val() === data.val() + 1 && newData.parent().child('codigoDisponible').val() === data.parent().child('codigoDisponible').val() + 1 && (newData.val() <= 250 || (root.child('planes').child($uid).child('plan').val() === 'premium' && newData.val() <= root.child('planes').child($uid).child('limite').val() && root.child('planes').child($uid).child('vigenteHasta').val() + 432000000 > now))) || (newData.val() === data.val() - 1 && root.child('productos').child($uid).child(newData.parent().child('ultimoBorrado').val() + '').exists() && !newData.parent().parent().parent().child('productos').child($uid).child(newData.parent().child('ultimoBorrado').val() + '').exists()))"
        },
        "ultimoBorrado": {
          ".validate": "newData.isString()"
        },
        "$otro": {
          ".validate": false
        }
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "productos": {
      "$uid": {
        ".read": "(!root.child('bloqueos').child($uid).exists() || (auth != null && auth.uid === $uid) || (auth != null && root.child('admins').child(auth.uid).val() === true))",
        ".indexOn": [
          "categoria"
        ],
        "$num": {
          ".write": "(auth != null && auth.uid === $uid && ((!data.exists() && newData.exists() && $num === root.child('negocios').child($uid).child('codigoDisponible').val() + '' && newData.parent().parent().parent().child('negocios').child($uid).child('codigoDisponible').val() === root.child('negocios').child($uid).child('codigoDisponible').val() + 1 && newData.parent().parent().parent().child('negocios').child($uid).child('totalItems').val() === root.child('negocios').child($uid).child('totalItems').val() + 1) || (data.exists() && newData.exists() && newData.child('numero').val() === data.child('numero').val()) || (data.exists() && !newData.exists() && newData.parent().parent().parent().child('negocios').child($uid).child('ultimoBorrado').val() === $num && newData.parent().parent().parent().child('negocios').child($uid).child('totalItems').val() === root.child('negocios').child($uid).child('totalItems').val() - 1))) && !root.child('bloqueos').child($uid).exists()",
          ".validate": "newData.hasChildren(['numero', 'codigo', 'categoria', 'precio', 'foto', 'disponible']) && newData.child('numero').val() + '' === $num",
          "numero": {
            ".validate": "newData.isNumber()"
          },
          "codigo": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "categoria": {
            ".validate": "newData.isString() && newData.val().matches(/^(ropa|zapatos|joyeria|ninos|hogar)$/)"
          },
          "precio": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "foto": {
            ".validate": "newData.isString() && newData.val().beginsWith('https://')"
          },
          "rutaFoto": {
            ".validate": "newData.isString()"
          },
          "disponible": {
            ".validate": "newData.isBoolean()"
          },
          "creadoEn": {
            ".validate": "newData.isNumber()"
          },
          "precioDesde": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "presentaciones": {
            "$tela": {
              ".validate": "newData.hasChildren(['disponible', 'precios']) && $tela.length <= 40",
              "disponible": {
                ".validate": "newData.isBoolean()"
              },
              "precios": {
                "$talla": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100000 && $talla.length <= 40"
                }
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "atributos": {
            "tipo": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "tacon": {
              ".validate": "newData.isString() && newData.val().matches(/^(sin|bajo|medio|alto)$/)"
            },
            "calce": {
              ".validate": "newData.isString() && newData.val().matches(/^(normal|pequena|grande)$/)"
            },
            "genero": {
              ".validate": "newData.isString() && newData.val().matches(/^(nina|nino|unisex)$/)"
            },
            "edad": {
              ".validate": "newData.isString() && newData.val().matches(/^(0a12m|1a3|3a5|6a8|9a12|12mas)$/)"
            },
            "medidas": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "$otro": {
              ".validate": false
            }
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "configCategorias": {
      "$uid": {
        ".read": "(!root.child('bloqueos').child($uid).exists() || (auth != null && auth.uid === $uid) || (auth != null && root.child('admins').child(auth.uid).val() === true))",
        ".write": "(auth != null && auth.uid === $uid) && !root.child('bloqueos').child($uid).exists()",
        "$cat": {
          ".validate": "$cat.matches(/^(ropa|zapatos|joyeria|ninos|hogar)$/)",
          "telas": {
            "$id": {
              ".validate": "newData.hasChildren(['nombre', 'orden']) && $id.length <= 40",
              "nombre": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "orden": {
                ".validate": "newData.isNumber()"
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "tallas": {
            "$id": {
              ".validate": "newData.hasChildren(['nombre', 'orden']) && $id.length <= 40",
              "nombre": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "orden": {
                ".validate": "newData.isNumber()"
              },
              "cm": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 50"
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "colores": {
            "$id": {
              ".validate": "newData.hasChildren(['nombre', 'orden']) && $id.length <= 40",
              "nombre": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "orden": {
                ".validate": "newData.isNumber()"
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "tipos": {
            "$id": {
              ".validate": "newData.hasChildren(['nombre', 'orden']) && $id.length <= 40",
              "nombre": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "orden": {
                ".validate": "newData.isNumber()"
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "materiales": {
            "$id": {
              ".validate": "newData.hasChildren(['nombre', 'orden']) && $id.length <= 40",
              "nombre": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "orden": {
                ".validate": "newData.isNumber()"
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "disenos": {
            "$id": {
              ".validate": "newData.hasChildren(['nombre', 'orden']) && $id.length <= 40",
              "nombre": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "orden": {
                ".validate": "newData.isNumber()"
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "pagos": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "(auth != null && auth.uid === $uid && !data.exists() && newData.child('estado').val() === 'pendiente' && !newData.child('revisadoEn').exists() && !newData.child('motivo').exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true && data.exists() && newData.exists())",
          ".validate": "newData.hasChildren(['monto', 'meses', 'banco', 'comprobante', 'rutaComprobante', 'tipoArchivo', 'estado', 'creadoEn'])",
          "monto": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100000"
          },
          "meses": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24"
          },
          "banco": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "referencia": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "comprobante": {
            ".validate": "newData.isString() && newData.val().beginsWith('https://')"
          },
          "rutaComprobante": {
            ".validate": "newData.isString() && newData.val().beginsWith('comprobantes/' + $uid + '/')"
          },
          "tipoArchivo": {
            ".validate": "newData.isString() && newData.val().matches(/^(image\\/.+|application\\/pdf)$/)"
          },
          "estado": {
            ".validate": "newData.isString() && newData.val().matches(/^(pendiente|aprobado|rechazado)$/)"
          },
          "motivo": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "creadoEn": {
            ".validate": "newData.isNumber()"
          },
          "revisadoEn": {
            ".validate": "newData.isNumber()"
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "bloqueos": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['motivo', 'desde'])",
        "motivo": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "desde": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "ajustes": {
      "pagos": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "banco": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "tipoCuenta": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "numeroCuenta": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "titular": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "nota": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "actualizadoEn": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}